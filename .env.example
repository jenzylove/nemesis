# Frontend
NEXT_PUBLIC_NEMESIS_API_URL=https://nemesis-api-staging-h7bnd6kzfq-uc.a.run.app
# Backend runtime
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO
# Google ADK and Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash
PUBSUB_TOPIC=nemesis-case-events
CLOUD_RUN_SERVICE_URL=https://nemesis-api-staging-h7bnd6kzfq-uc.a.run.app
INTERNAL_SERVICE_ACCOUNT=nemesis-runtime@nemesis-506114.iam.gserviceaccount.com
MONITORING_MAX_BLOCKS=20
ADK_APP_NAME=nemesis
# Firestore
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_CASES_COLLECTION=cases
# Frontend origin allowed by FastAPI
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
# Deterministic blockchain providers
ETHEREUM_RPC_URL=
BASE_RPC_URL=
RPC_TIMEOUT_SECONDS=20
